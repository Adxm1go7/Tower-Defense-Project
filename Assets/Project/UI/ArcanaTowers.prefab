  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A powerful magic skeleton that channels chain lightning.

    Its attacks
    jump between multiple slymes, locking them down and dealing consistent damage
    across groups.

    This makes it especially effective against fast or tightly
    packed waves.

    Excellent for controlling the battlefield and preventing slymes
    from breaking through.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
